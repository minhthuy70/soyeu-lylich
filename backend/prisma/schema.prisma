generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int      @id @default(autoincrement())
  email                   String   @unique
  passwordHash            String?
  isEmailVerified         Boolean  @default(false)
  verificationToken       String?  @unique
  verificationTokenExpiry DateTime?
  failedLoginAttempts     Int      @default(0)
  lockedUntil             DateTime?
  resetPasswordToken      String?  @unique
  resetPasswordExpiry     DateTime?
  profile                 Profile?
  socialAccounts          SocialAccount[]
  sessions                Session[]
  identityDocuments        IdentityDocument[]
  references              Reference[]
  educations              Education[]
  certificates            Certificate[]
  onlineCourses           OnlineCourse[]
  experiences             Experience[]
  freelanceProjects       FreelanceProject[]
  skills                  Skill[]
  softSkills               SoftSkill[]
  languageSkills          LanguageSkill[]
  toolSkills               ToolSkill[]
  projects                Project[]
  achievements            Achievement[]
  activities              Activity[]
  publications            Publication[]
  patents                 Patent[]
  resumes                 Resume[]
  twoFactorEnabled        Boolean  @default(false)
  twoFactorSecret          String?  @unique
  twoFactorBackupCodes     String[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

model Profile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String?
  dateOfBirth  DateTime?
  gender       String?
  placeOfBirth String?
  nationality  String?
  maritalStatus String?
  personalPhoto String?
  introduction String?
  religion     String?
  ethnicity    String?
  bloodType    String?
  height       Int?
  weight       Int?
  phoneNumber  String?
  secondaryPhone String?
  currentAddress String?
  permanentAddress String?
  email        String?
  socialLinks   String[] // Array of social media URLs
  personalWebsite String?
  emergencyContact String?
  careerObjective String?
  desiredPosition String?
  expectedSalary String?
  workLocationPreference String?
  workTypePreference String?
  availableFromDate DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SocialAccount {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // 'google', 'github', 'facebook', 'linkedin'
  providerId   String   // ID from the social provider
  email        String?
  accessToken  String?
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([provider, providerId])
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IdentityDocument {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentType String   // 'CMND', 'CCCD', 'Hộ chiếu', 'Passport', v.v.
  documentNumber String
  issueDate    DateTime?
  issuePlace   String?
  expiryDate   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Reference {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  position     String?
  company      String?
  contact      String?
  relationship String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Education {
  id                 Int      @id @default(autoincrement())
  userId             Int
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  schoolName         String
  major              String?
  degree             String?
  startDate          DateTime?
  endDate            DateTime?
  currentStudyStatus  String? // 'Đang học', 'Đã tốt nghiệp', 'Đã bỏ học'
  gpa                String?
  academicAchievements String[]
  description         String?
  thesisTopic         String?
  relevantCoursework  String[]
  studyAbroad        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Certificate {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  issuingOrganization String?
  issueDate           DateTime?
  expiryDate          DateTime?
  certificateId       String?
  certificateUrl      String?
  certificateImage    String?
  expiryReminderDays  Int? @default(30)
  category            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model OnlineCourse {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseName      String
  platform        String?
  instructor      String?
  completionDate  DateTime?
  courseUrl       String?
  certificateUrl  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Experience {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String
  position            String
  employmentType      String? // 'Full-time', 'Part-time', 'Contract', 'Freelance'
  startDate           DateTime?
  endDate             DateTime?
  currentJobStatus    Boolean  @default(false)
  jobDescription      String?
  responsibilities     String[]
  achievements         String[]
  technologiesUsed    String[]
  companyWebsite      String?
  companyLogo         String?
  workLocation        String?
  workType            String? // 'Remote', 'Onsite', 'Hybrid'
  salaryRange         String?
  reasonForLeaving    String?
  supervisorName      String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model FreelanceProject {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName      String
  projectScope    String?
  rate            String?
  budget          String?
  duration        String?
  startDate       DateTime?
  endDate         DateTime?
  technologies    String[]
  outcome         String?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Skill {
  id                Int      @id @default(autoincrement())
  userId            Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name              String
  category          String?
  level             String? // 'Beginner', 'Intermediate', 'Advanced', 'Expert'
  yearsOfExperience Int?
  description       String?
  progress          Int? @default(0)
  tags              String[]
  endorsementCount  Int? @default(0)
  portfolioLink     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SoftSkill {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  level       String? // 'Beginner', 'Intermediate', 'Advanced', 'Expert'
  description String?
  progress    Int? @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LanguageSkill {
  id                  Int      @id @default(autoincrement())
  userId              Int
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  language            String
  proficiencyLevel    String? // 'Basic', 'Conversational', 'Professional', 'Native'
  listeningLevel      String? // 'Basic', 'Intermediate', 'Advanced', 'Native'
  speakingLevel       String? // 'Basic', 'Intermediate', 'Advanced', 'Native'
  readingLevel        String? // 'Basic', 'Intermediate', 'Advanced', 'Native'
  writingLevel        String? // 'Basic', 'Intermediate', 'Advanced', 'Native'
  certificateScore    String?
  certificateInfo     String?
  cefrLevel           String? // 'A1', 'A2', 'B1', 'B2', 'C1', 'C2'
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ToolSkill {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  proficiencyLevel String? // 'Beginner', 'Intermediate', 'Advanced', 'Expert'
  yearsOfUse     Int?
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Project {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  role            String?
  startDate       DateTime?
  endDate         DateTime?
  technologies    String[]
  images          String[]
  githubUrl       String?
  demoUrl         String?
  status          String? // 'Planning', 'In Progress', 'Completed', 'On Hold', 'Cancelled'
  order           Int      @default(0)
  category        String?
  teamSize        Int?
  highlights      String[]
  challenges      String?
  solutions       String?
  impact          String?
  client          String?
  projectImages   ProjectImage[]
  projectViews    ProjectView[]
  projectClicks   ProjectClick[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectImage {
  id              Int      @id @default(autoincrement())
  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl        String
  caption         String?
  order           Int      @default(0)
  isThumbnail     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ProjectView {
  id              Int      @id @default(autoincrement())
  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  viewerIp        String?
  viewerUserAgent String?
  viewedAt        DateTime @default(now())
}

model ProjectClick {
  id              Int      @id @default(autoincrement())
  projectId       Int
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clickType       String // 'github', 'demo', 'image'
  clickUrl        String?
  clickedAt       DateTime @default(now())
}

model Achievement {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  organization    String?
  achievementDate DateTime?
  description     String?
  evidenceUrl     String?
  imageUrl        String?
  category        String? // 'Academic', 'Professional', 'Sports', 'Arts', 'Other'
  level           String? // 'School', 'District', 'Provincial', 'National', 'International'
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Activity {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    String
  position        String?
  startDate       DateTime?
  endDate         DateTime?
  description     String?
  achievements    String[]
  type            String? // 'Volunteer', 'Club', 'Sports', 'Cultural', 'Academic', 'Other'
  memberCount     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Publication {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  journal         String?
  conference      String?
  publicationDate DateTime?
  coAuthors       String[]
  doi             String?
  url             String?
  abstract        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Patent {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  patentNumber    String?
  title           String
  filingDate      DateTime?
  status          String? // 'Pending', 'Granted', 'Rejected', 'Abandoned'
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Resume {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  template        String? // 'Modern', 'Professional', 'Minimal', 'Academic', 'Creative', 'TwoColumn', 'Infographic'
  colorScheme     String?
  font            String?
  isDefault       Boolean  @default(false)
  parentResumeId  Int?
  parentResume    Resume?  @relation("ResumeVersions", fields: [parentResumeId], references: [id], onDelete: SetNull)
  versions        Resume[] @relation("ResumeVersions")
  sections        ResumeSection[]
  isPublic        Boolean  @default(false)
  publicSlug      String?  @unique
  publicPassword  String?
  publicExpiryDate DateTime?
  publicViewCount Int      @default(0)
  views           ResumeView[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([parentResumeId])
  @@index([publicSlug])
}

model ResumeView {
  id          Int      @id @default(autoincrement())
  resumeId    Int
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  viewerIp    String?
  deviceType  String?  // 'desktop', 'mobile', 'tablet'
  browser     String?
  country     String?
  city        String?
  referralSource String?
  viewedAt    DateTime @default(now())

  @@index([resumeId])
  @@index([viewedAt])
}

model ResumeSection {
  id              Int      @id @default(autoincrement())
  resumeId        Int
  resume          Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  sectionType     String // 'BasicInfo', 'Contact', 'Identity', 'CareerObjective', 'Skills', 'Experience', 'Education', 'Certificates', 'Projects', 'Activities', 'Achievements', 'Publications', 'Patents'
  customName      String?
  description     String?
  isEnabled       Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}